{
  "name": "argus-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "electron:compile": "tsc -p electron/tsconfig.json && node scripts/preload.cjs",
    "desktop": "npm run electron:compile && concurrently -k -s first \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && node scripts/launch.cjs\"",
    "build": "tsc -b && vite build && npm run electron:compile",
    "build:web": "tsc -b && VITE_ARGUS_SERVED=1 vite build --base=/ --outDir dist-web",
    "start": "node scripts/launch.cjs --production",
    "test": "vitest run",
    "test:ui": "playwright test",
    "test:camera-stream": "playwright test --config playwright.camera.config.ts",
    "test:ws-auth": "playwright test --config playwright.ws-auth.config.ts",
    "test:electron:bridge": "playwright test --config playwright.electron.config.ts",
    "preview": "vite preview --host 127.0.0.1",
    "dist": "electron-builder --config electron-builder.yml"
  },
  "dependencies": {
    "lucide-react": "1.43.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.5.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "electron": "44.2.0",
    "electron-builder": "26.0.12",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0",
    "wait-on": "9.1.0"
  }
}
